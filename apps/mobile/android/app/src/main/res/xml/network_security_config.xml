<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext (http) traffic to any host, and only the system trust store:
     certificates installed by the user are not trusted, in debug builds too. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
