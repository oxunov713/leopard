# Copy to .env (never commit it) and export before running, e.g. `set -a; . ./.env; set +a`.

# Postgres connection string. Neon requires sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Listen port (Cloud Run sets this itself).
PORT=8080

# Exact origin(s) of the web app, comma separated. No trailing slash, no path.
LEOPARD_WEB_ORIGIN=http://localhost:5173

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts the TOTP secret at rest. Losing it disables master-password login.
LEOPARD_SERVER_KEY=

# 1 on Cloud Run (one trusted proxy appends the client IP to X-Forwarded-For).
# Leave unset when clients connect directly.
LEOPARD_TRUST_PROXY=

# Optional but recommended: POST /v1/setup must send this in X-Leopard-Setup-Token.
LEOPARD_SETUP_TOKEN=

# Local development only: keep everything in memory, no Postgres needed.
# LEOPARD_DEV_MEMSTORE=1
